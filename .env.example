# Optional. Where /api/subscribe forwards consented sign-ups (e.g. your email
# provider's webhook). If unset, sign-ups are validated and acknowledged but
# not stored anywhere.
SUBSCRIBE_WEBHOOK_URL=
SUBSCRIBE_WEBHOOK_TOKEN=

# Optional. Where visitor feedback goes (see app/api/feedback/route.ts).
# GitHub issues: a fine-grained token with "Issues: read & write" on this repo only.
FEEDBACK_GITHUB_REPO=kstetsenko/beauty
FEEDBACK_GITHUB_TOKEN=
# Or a webhook (Slack, Zapier, email service):
FEEDBACK_WEBHOOK_URL=

# Referral tracking (see docs/TRACKING.md). Supabase free plan, no card needed.
# Project Settings → API: the project URL and the *service_role* key (server only; never NEXT_PUBLIC_).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# A long random password for the owner-only page /report (at least 16 characters).
REPORT_KEY=
# Local testing only: save tracking to .data/*.jsonl when running a production build.
TRACKING_LOCAL_FILE=
